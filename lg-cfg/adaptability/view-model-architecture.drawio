        <mxCell id="bxtMEhQBY8n54AWhR011-99" value="Собираем все текущее новое чистое состояние&amp;nbsp; и передаем в&amp;nbsp; мереджер презентационной модели" style="shape=label;whiteSpace=wrap;html=1;backgroundOutline=1;rounded=0;" vertex="1" parent="bxtMEhQBY8n54AWhR011-13">
